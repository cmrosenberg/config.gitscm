[user]
        name = Carl Martin Rosenberg
        email = github@cmrosenberg.com
[alias]
        unstage = restore --staged

[branch]
        sort = -comitterdate
[tag]
        sort = version:refname
[core]
        excludesfile = ~/.gitignore
        editor = vim

[include]
        path = ~/.gitconfig.local
[pull]
        ff = only
        rebase = false
[init]
        defaultBranch = main

[help]
        autocorrect = prompt
[commit]
	gpgsign = true
	verbose = true
